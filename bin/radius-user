#!/bin/bash
set -euo pipefail

RADDB=/etc/freeradius/3.0
USERS_DIR=/data/users.d
AUTHORIZE="$RADDB/mods-config/files/authorize"
LOG=/data/log/radius.log

die() { echo "radius-user: $*" >&2; exit 1; }

usage() {
    cat <<USAGE
Usage: radius-user <command> [args]

  add <username> <admin|agent>   create a profile (password is prompted, hidden)
  passwd <username>              change a profile password
  del <username>                 delete a profile
  list                           list profiles and roles
  test <username>                send a test Access-Request to the local server
  status                         show whether FreeRADIUS is running and the last log lines
  restart                        restart FreeRADIUS

Roles:
  admin   priv-lvl 15
  agent   priv-lvl 15, Idle-Timeout ${AGENT_IDLE_TIMEOUT:-300}s, Session-Timeout ${AGENT_SESSION_TIMEOUT:-3600}s
USAGE
}

check_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "invalid username '${1:-}' (allowed: letters, digits, . _ -, max 32)"
}

read_password() {
    local pw1 pw2
    read -rsp "Password: " pw1; echo >&2
    read -rsp "Repeat password: " pw2; echo >&2
    [ "$pw1" = "$pw2" ] || die "passwords do not match"
    [ "${#pw1}" -ge 8 ] || die "password must be at least 8 characters"
    PASSWORD="$pw1"
}

write_profile() {
    local name="$1" role="$2" hash
    hash="$(printf '%s' "$PASSWORD" | openssl passwd -6 -stdin)"
    umask 077
    mkdir -p "$USERS_DIR"
    {
        echo "# role: $role"
        printf '%s\tCrypt-Password := "%s"\n' "$name" "$hash"
        if [ "$role" = "agent" ]; then
            printf '\tService-Type = NAS-Prompt-User,\n'
            printf '\tCisco-AVPair = "shell:priv-lvl=15",\n'
            printf '\tIdle-Timeout = %s,\n' "${AGENT_IDLE_TIMEOUT:-300}"
            printf '\tSession-Timeout = %s\n' "${AGENT_SESSION_TIMEOUT:-3600}"
        else
            printf '\tService-Type = NAS-Prompt-User,\n'
            printf '\tCisco-AVPair = "shell:priv-lvl=15"\n'
        fi
        echo
    } > "$USERS_DIR/$name"
}

role_of() { sed -n 's/^# role: //p' "$USERS_DIR/$1" 2>/dev/null; }

restart() {
    local pids
    pids="$(pidof freeradius || true)"
    if [ -n "$pids" ]; then
        kill $pids
        for _ in $(seq 50); do pidof freeradius >/dev/null || break; sleep 0.1; done
    fi
    freeradius -l "$LOG"
    echo "FreeRADIUS restarted"
}

rebuild() {
    mkdir -p "$USERS_DIR"
    : > "$AUTHORIZE"
    for f in "$USERS_DIR"/*; do
        [ -f "$f" ] && cat "$f" >> "$AUTHORIZE"
    done
    chown root:freerad "$AUTHORIZE"
    chmod 640 "$AUTHORIZE"
    [ "${1:-}" = "--no-restart" ] || restart
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    add)
        check_name "${1:-}"
        [[ "${2:-}" =~ ^(admin|agent)$ ]] || die "role must be 'admin' or 'agent'"
        [ ! -e "$USERS_DIR/$1" ] || die "profile '$1' already exists (use passwd or del)"
        read_password
        write_profile "$1" "$2"
        rebuild
        echo "Profile '$1' created with role $2"
        ;;
    passwd)
        check_name "${1:-}"
        role="$(role_of "$1")"
        [ -n "$role" ] || die "profile '$1' does not exist"
        read_password
        write_profile "$1" "$role"
        rebuild
        echo "Password changed for '$1'"
        ;;
    del)
        check_name "${1:-}"
        [ -e "$USERS_DIR/$1" ] || die "profile '$1' does not exist"
        rm -f "$USERS_DIR/$1"
        rebuild
        echo "Profile '$1' deleted"
        ;;
    list)
        for f in "$USERS_DIR"/*; do
            [ -f "$f" ] || continue
            if [ "${1:-}" = "--names" ]; then
                basename "$f"
            else
                printf '%-32s %s\n' "$(basename "$f")" "$(role_of "$(basename "$f")")"
            fi
        done
        ;;
    test)
        check_name "${1:-}"
        read -rsp "Password: " pw; echo >&2
        pw="${pw//\\/\\\\}"
        pw="${pw//\"/\\\"}"
        printf 'User-Name = "%s"\nUser-Password = "%s"\n' "$1" "$pw" \
            | radclient -r 1 -t 3 127.0.0.1:1812 auth "$AAA_RADIUS_KEY"
        ;;
    rebuild)
        rebuild "${1:-}"
        ;;
    restart)
        restart
        ;;
    status)
        if pidof freeradius >/dev/null; then echo "FreeRADIUS is running (pid $(pidof freeradius))"; else echo "FreeRADIUS is NOT running"; fi
        tail -n 15 "$LOG" 2>/dev/null || true
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage; exit 1
        ;;
esac
