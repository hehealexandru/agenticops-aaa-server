#!/bin/bash
set -euo pipefail

# shellcheck source=lib/aaa-common.sh
. /usr/local/lib/aaa/aaa-common.sh

USERS_DIR="$DATA/users.d"
AUTHORIZE="$RADDB/mods-config/files/authorize"

die() { echo "radius-user: $*" >&2; exit 1; }

usage() {
    cat <<USAGE
Usage: radius-user <command> [args]

  add <username> <admin|agent>   create a profile (password is prompted, hidden)
  passwd <username>              change a profile password
  del <username>                 delete a profile
  list                           list profiles and roles
  test <username>                send a test Access-Request to the local server
  status                         show the FreeRADIUS state, a live probe and the last log lines
  restart                        check the configuration, then restart FreeRADIUS
  start                          start FreeRADIUS after a failure (maintenance mode)

Roles:
  admin   priv-lvl 15
  agent   priv-lvl 15, Idle-Timeout ${AGENT_IDLE_TIMEOUT:-300}s, Session-Timeout ${AGENT_SESSION_TIMEOUT:-3600}s
USAGE
}

check_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "invalid username '${1:-}' (allowed: letters, digits, . _ -, max 32)"
}

read_password() {
    local pw1 pw2
    read -rsp "Password: " pw1; echo >&2
    read -rsp "Repeat password: " pw2; echo >&2
    [ "$pw1" = "$pw2" ] || die "passwords do not match"
    [ "${#pw1}" -ge 8 ] || die "password must be at least 8 characters"
    PASSWORD="$pw1"
}

write_profile() {
    local name="$1" role="$2" hash
    hash="$(printf '%s' "$PASSWORD" | openssl passwd -6 -stdin)"
    umask 077
    mkdir -p "$USERS_DIR"
    {
        echo "# role: $role"
        printf '%s\tCrypt-Password := "%s"\n' "$name" "$hash"
        if [ "$role" = "agent" ]; then
            printf '\tService-Type = NAS-Prompt-User,\n'
            printf '\tCisco-AVPair = "shell:priv-lvl=15",\n'
            printf '\tIdle-Timeout = %s,\n' "${AGENT_IDLE_TIMEOUT:-300}"
            printf '\tSession-Timeout = %s\n' "${AGENT_SESSION_TIMEOUT:-3600}"
        else
            printf '\tService-Type = NAS-Prompt-User,\n'
            printf '\tCisco-AVPair = "shell:priv-lvl=15"\n'
        fi
        echo
    } > "$USERS_DIR/$name"
}

role_of() { sed -n 's/^# role: //p' "$USERS_DIR/$1" 2>/dev/null; }

# Refuse to touch the running server when the new configuration is broken.
check_config() {
    radius_config_ok && return 0
    freeradius -XC 2>&1 | tail -n 20 >&2
    die "FreeRADIUS configuration check failed; the running server was not touched"
}

# Wait until FreeRADIUS answers Status-Server with a pid different from $1.
wait_answering() {
    local old_pid="${1:-}" pid
    for _ in $(seq 40); do
        pid="$(state_get radius pid)"
        if [ "$(state_get radius state)" = running ] && [ -n "$pid" ] && [ "$pid" != "$old_pid" ] \
            && radius_probe; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

restart() {
    local sup old_pid
    sup="$(supervisor_pid radius)" \
        || die "FreeRADIUS is not running (maintenance mode?); check 'radius-user status', then use 'radius-user start'"
    check_config
    old_pid="$(state_get radius pid)"
    kill -HUP "$sup"
    wait_answering "$old_pid" || die "FreeRADIUS did not come back; see 'radius-user status'"
    echo "FreeRADIUS restarted"
}

start() {
    local main
    if supervisor_pid radius >/dev/null; then
        echo "FreeRADIUS is already running (use 'radius-user restart')"
        return 0
    fi
    main="$(main_pid)" || die "the AAA server main process is not running"
    check_config
    rm -f "$(failed_marker radius)"
    kill -USR1 "$main"
    wait_answering "" || die "FreeRADIUS did not start; see 'radius-user status'"
    echo "FreeRADIUS started"
}

rebuild() {
    mkdir -p "$USERS_DIR"
    : > "$AUTHORIZE"
    for f in "$USERS_DIR"/*; do
        [ -f "$f" ] && cat "$f" >> "$AUTHORIZE"
    done
    chown root:freerad "$AUTHORIZE"
    chmod 640 "$AUTHORIZE"
    [ "${1:-}" = "--no-restart" ] && return 0
    if supervisor_pid radius >/dev/null; then
        restart
    else
        echo "FreeRADIUS is not running: the change applies at the next 'radius-user start'" >&2
    fi
}

status() {
    local state pid restarts since marker
    marker="$(failed_marker radius)"
    state="$(state_get radius state)"
    pid="$(state_get radius pid)"
    restarts="$(state_get radius restarts)"
    since="$(state_get radius since)"
    case "${state:-unknown}" in
        running)    echo "FreeRADIUS: running (pid $pid, since $since)" ;;
        restarting) echo "FreeRADIUS: RESTARTING after a crash (since $since)" ;;
        *)          echo "FreeRADIUS: NOT running (${state:-unknown}${since:+, since $since})" ;;
    esac
    echo "Unexpected restarts in the last ${AAA_RESTART_WINDOW:-60}s: ${restarts:-0} (limit ${AAA_MAX_RESTARTS:-5})"
    if [ -e "$marker" ]; then
        echo "MAINTENANCE MODE: $(sed -n 's/^reason=//p' "$marker")"
        echo "  failed at: $(sed -n 's/^time=//p' "$marker")"
        echo "  report:    $(sed -n 's/^report=//p' "$marker")"
        echo "  fix the cause, then run: radius-user start"
    fi
    if radius_probe; then
        echo "Status-Server probe on 127.0.0.1:1812: OK"
    else
        echo "Status-Server probe on 127.0.0.1:1812: NO ANSWER"
    fi
    echo "--- $SUPERVISOR_LOG"
    tail -n 5 "$SUPERVISOR_LOG" 2>/dev/null || true
    echo "--- $RADIUS_LOG"
    tail -n 10 "$RADIUS_LOG" 2>/dev/null || true
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    add)
        check_name "${1:-}"
        [[ "${2:-}" =~ ^(admin|agent)$ ]] || die "role must be 'admin' or 'agent'"
        [ ! -e "$USERS_DIR/$1" ] || die "profile '$1' already exists (use passwd or del)"
        read_password
        write_profile "$1" "$2"
        rebuild
        echo "Profile '$1' created with role $2"
        ;;
    passwd)
        check_name "${1:-}"
        role="$(role_of "$1")"
        [ -n "$role" ] || die "profile '$1' does not exist"
        read_password
        write_profile "$1" "$role"
        rebuild
        echo "Password changed for '$1'"
        ;;
    del)
        check_name "${1:-}"
        [ -e "$USERS_DIR/$1" ] || die "profile '$1' does not exist"
        rm -f "$USERS_DIR/$1"
        rebuild
        echo "Profile '$1' deleted"
        ;;
    list)
        for f in "$USERS_DIR"/*; do
            [ -f "$f" ] || continue
            if [ "${1:-}" = "--names" ]; then
                basename "$f"
            else
                printf '%-32s %s\n' "$(basename "$f")" "$(role_of "$(basename "$f")")"
            fi
        done
        ;;
    test)
        check_name "${1:-}"
        [ -r "$RADIUS_SECRET_FILE" ] || die "shared secret file $RADIUS_SECRET_FILE is missing"
        read -rsp "Password: " pw; echo >&2
        pw="${pw//\\/\\\\}"
        pw="${pw//\"/\\\"}"
        # The secret is read from a root-only file (-S), never passed on the command line.
        printf 'User-Name = "%s"\nUser-Password = "%s"\n' "$1" "$pw" \
            | radclient -r 1 -t 3 -S "$RADIUS_SECRET_FILE" 127.0.0.1:1812 auth
        ;;
    rebuild)
        rebuild "${1:-}"
        ;;
    restart)
        restart
        ;;
    start)
        start
        ;;
    status)
        status
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage; exit 1
        ;;
esac